@page "/Register"

@using RealEstateProj.Data
@using RealEstateProj.Data.Interfaces
@using RealEstateProj.Data.Service
@using RealEstateProj.Identity
@using Microsoft.AspNetCore.Components.Web

@inject IUserService UserService
@inject NavigationManager Navigation



<div class="login-page">
    <div class="login-card">
        <h2 class="login-title">Create a new account</h2>

        <div class="login-form">
            <EditForm Model="@user" OnValidSubmit="HandleSubmit" FormName="RegisterForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="input-group">
                    <InputText @bind-Value="user.UserName" placeholder="Username" />
                    <i class="fa fa-user"></i>
                </div>
                <div class="input-group">
                    <InputText @bind-Value="user.Email" placeholder="Email" />
                    <i class="fa fa-envelope"></i>
                </div>
                <div class="input-group">
                    <InputText @bind-Value="user.PasswordHashed" type="password" placeholder="Password" />
                    <i class="fa fa-lock"></i>
                </div>

                <button type="submit" class="login-btn">Create</button>
            </EditForm>
        </div>
        
        @if (massage != "")
        {
            <div class="login-message @(isError ? "error" : "success")">
                @massage
            </div>
        }

        <div class="login-footer">
            <span>Already have an account?</span>
            <button class="switch-btn" @onclick='() => Navigation.NavigateTo("/login")'>Log In</button>
        </div>
    </div>
</div>


@code {
    User user = new User();
    string massage = "";
    bool isError;

    public void HandleSubmit(EditContext editContext)
    {
        var newUser = (User)editContext.Model;
        if (UserService.CheckIfUserExists(newUser))
        {
            massage = "User already exists";
            isError = true;
            return;
        }

        UserService.AddUser(newUser);
        massage = "User added successfully!";
        isError = false;

        user = new User();
    }
}
