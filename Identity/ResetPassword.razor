@page "/ResetUserPassword"

@using RealEstateProj.Data
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using RealEstateProj.Data

@inject RealEstateProj.Data.Interfaces.IUserService UserService

<div class="card-wrapper">
    <label>Email</label>
    <InputText @bind-Value="email" placeholder="enter email" />

    <label>New password</label>
    <InputText type="password" @bind-Value="NewPassword" placeholder="enter new password" />

    <label>Confirm password</label>
    <InputText type="password" @bind-Value="NewPassword1" placeholder="enter again" />

    @if (message != "")
    {
        <span style="color:blueviolet">@message</span>
    }
    <button @onclick="Reset">Reset password</button>

</div>

<p>@user.ID</p>

@code {
    string email = "";
    string NewPassword = "";
    string NewPassword1 = "";
    string message = "";
    User? user = new();


    void Reset()
    {
        if (string.IsNullOrWhiteSpace(email) ||
           string.IsNullOrWhiteSpace(NewPassword) ||
           NewPassword != NewPassword1)
        {
            message = "Enter email and matching passwords.";
          
            return;
        }

        user = UserService.GetUserByEmail(email);
        try
        {
            UserService.ResetPassword(user, NewPassword);
            message = "success";
          
        }
        catch (ArgumentNullException ex)
        {
            message = $"Missing argument: {ex.ParamName}";
        }
       
        
    }
}
