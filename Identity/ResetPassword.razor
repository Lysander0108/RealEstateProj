@page "/ResetUserPassword"

@using RealEstateProj.Data
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@inject IUserService UserService
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-card card-wrapper">
        <h2 class="login-title">Reset password</h2>

        <div class="login-form">
            <div class="input-group">
                <label>Email</label>
                <InputText @bind-Value="email" placeholder="enter email" class="input-field" />
            </div>

            <div class="input-group">
                <label>New password</label>
                <InputText type="password" @bind-Value="NewPassword" placeholder="enter new password" class="input-field" />
            </div>

            <div class="input-group">
                <label>Confirm password</label>
                <InputText type="password" @bind-Value="NewPassword1" placeholder="enter again" class="input-field" />
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="login-message @(isError ? "error" : "success")">@message</div>
            }

            <div class="login-footer">
                <button class="login-btn" @onclick="Reset">Reset password</button>
                <a class="login-link" href="/login">Back to log in</a>
            </div>
        </div>
    </div>
</div>

@code {
    string email = string.Empty;
    string NewPassword = string.Empty;
    string NewPassword1 = string.Empty;
    string message = string.Empty;
    bool isError = false;
    User? user = null;
    //TODO make tthe styling normal for the reset password page, and make it look like the login page.
    void Reset()
    {
        isError = false;
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(email) ||
           string.IsNullOrWhiteSpace(NewPassword) ||
           NewPassword != NewPassword1)
        {
            isError = true;
            message = "Enter email and matching passwords.";
            return;
        }

        user = UserService.GetUserByEmail(email);
        if (user == null)
        {
            isError = true;
            message = "No user found with that email.";
            return;
        }

        try
        {
            UserService.ResetPassword(user, NewPassword);
            isError = false;
            message = "Password was reset successfully.";
        }
        catch (ArgumentNullException ex)
        {
            isError = true;
            message = $"Missing argument: {ex.ParamName}";
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Failed to reset password: {ex.Message}";
        }
    }
}
