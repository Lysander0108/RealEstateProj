```razor
@inject IPropertyService propertyservice
@inject PropertyFilter Filter
@inject NavigationManager NavMag

@using RealEstateProj.Components.Pages
@using RealEstateProj.Data
@using RealEstateProj.Data.DTO

@if (!properties.Any())
{
    <p>No properties found</p>
}

@foreach (var property in properties)
{
    <ProperyCard PropertyId="@property.Id"
                 Title="@property.Title"
                 City="@property.City"
                 Address="@property.Address"
                 Price="@property.Price"
                 Rooms="@property.Rooms"
                 Size="@property.Size"
                 Status="@property.Status"
                 Description="@property.Description"
                 Images="@property.Images" />
}

<div class="filter-bar-body">

    <div class="filter-group price">

        <div class="input-icon">
            <i class="fa-solid fa-money-bill"></i>
            <input type="number"
                   placeholder="Min Price"
                   @bind="Filter.MinPrice" />
        </div>

        <div class="input-icon">
            <i class="fa-solid fa-money-bill"></i>
            <input type="number"
                   placeholder="Max Price"
                   @bind="Filter.MaxPrice" />
        </div>

    </div>

    <div class="filter-group">

        <div class="input-icon">
            <i class="fa-solid fa-heading"></i>
            <input type="text"
                   placeholder="Title"
                   @bind="Filter.Title" />
        </div>

        <div class="input-icon">
            <i class="fa-solid fa-city"></i>
            <input type="text"
                   placeholder="City"
                   @bind="Filter.City" />
        </div>

        <div class="input-icon">
            <i class="fa-solid fa-location-dot"></i>
            <input type="text"
                   placeholder="Address"
                   @bind="Filter.Address" />
        </div>

        <div class="input-icon">
            <i class="fa-solid fa-door-open"></i>
            <input type="number"
                   placeholder="Rooms"
                   @bind="Filter.Rooms" />
        </div>

        <div class="input-icon">
            <i class="fa-solid fa-ruler-combined"></i>
            <input type="number"
                   placeholder="Size"
                   @bind="Filter.Size" />
        </div>

        <div class="input-icon">
            <i class="fa-solid fa-tag"></i>
            <input type="text"
                   placeholder="Rent/Sale"
                   @bind="StatusInput" />
        </div>

        <div class="input-icon">
            <i class="fa-solid fa-align-left"></i>
            <input type="text"
                   placeholder="Description"
                   @bind="Filter.Description" />
        </div>

    </div>

    <button class="filter-btn" @onclick="ApplyFilters">
        Apply Filters
    </button>

</div>

@code {
    String? StatusInput;
    private List<Property> properties = new();

    private async Task ApplyFilters()
    {
        Filter.Status = null;

        switch (StatusInput?.Trim().ToLowerInvariant())
        {
            case "rent":
                Filter.Status = Status.Rent;
                break;

            case "sale":
                Filter.Status = Status.Sale;
                break;

            case "bought":
                Filter.Status = Status.Bought;
                break;
        }

        properties = await propertyservice.FilterAsync(Filter);
    }

    protected override void OnInitialized()
    {
        
        properties = new();
    }
}
