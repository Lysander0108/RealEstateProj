@inject IPropertyService propertyservice
@inject PropertyFilterDTO Filter
@inject NavigationManager NavMag

@using Radzen.Blazor
@using RealEstateProj.Components.Pages
@using RealEstateProj.Data
@using RealEstateProj.Data.DTO

<div class="parent">
    <aside class="filter-bar">
        <header><h2> filter</h2></header>
        <EditForm Model="filterModel">
            
            <section>
                <h6>city</h6>
                <InputText PlaceHolder="City" DisplayName="City" @bind-Value="filterModel.City"/>
            </section>
            
            <section>
                <h6>Status</h6>
                <InputText PlaceHlder="Status" DisplayName="Status" @bind-Value="status"></InputText>
            </section>
            
            <section>
                <h6>rooms</h6>
                <div class="rooms">
                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(1, e)" />
                        1
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(1.5, e)" />
                        1.5
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(2, e)" />
                        2
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(2.5, e)" />
                        2.5
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(3, e)" />
                        3
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(4.5, e)" />
                        4.5
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(5, e)" />
                        5
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(5.5, e)" />
                        5.5
                    </div>

                    <div class="room-number">
                        <input type="checkbox" @onchange="e => RoomChanged(6, e)" />
                        6+
                    </div>
                </div>
            </section>
            
            <section>
                <RadzenSlider Range="true" @bind-Value="@rangeValues" Min="3000" Max="1000000" TValue="IEnumerable<double>" />
                <p></p>
            </section>
        </EditForm>
    </aside>
</div>

@code {
    double[] rangeValues = new double[] { 20.0, 80.0 };
                List<double> rooms = new();
               

void RoomChanged(double room, ChangeEventArgs e)
    {
       bool checkedValue = (bool)e.Value!;

         if (checkedValue)
            rooms.Add(room);
          else
             rooms.Remove(room);
                    
                }
            
    PropertyFilterDTO filterModel = new PropertyFilterDTO();
    string status;

    protected override void OnInitialized()
    {
        double min = rangeValues[0];
        double max = rangeValues[1];
    }

}
            