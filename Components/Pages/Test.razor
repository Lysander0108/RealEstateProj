@page "/test"
@using RealEstateProj.Data;
@using Microsoft.AspNetCore.Components.Forms
@using RealEstateProj.Data.Interfaces
@using RealEstateProj.Data.Service
@using RealEstateProj.Components.Pages.Identity

@inject IUserService UserService;
@inject IPropertyService propertyService;
@inject AuthService authService;
@inject NavigationManager navmag;

<PageTitle>Test</PageTitle>


<h3>property card</h3>

@foreach (var property in properties)
{
    <ProperyCard Title="@property.Title" City="@property.City" Address="@property.Address" Price="property.Price" Rooms="@property.Rooms" Size="@property.Size" Status="@property.Status" Images="@property.Images"></ProperyCard>
}


<h3>Get all users</h3>
<button @onclick="GetAllUsers">Show All Users</button>
<br/>
@if(allUsers != null)
{
    foreach(var user in allUsers)
    {
        <text>Name: @user.UserName, Email: @user.Email <br/> </text>
    }
}


@*TODO add placeholders *@
<h3> logout</h3>
<button @onclick="Logout">log out</button>

@if (authService.CurrentUser != null)
{
    <div style="margin-top: 0.75rem; padding: 0.75rem; background: rgba(218,171,45,0.08); border: 1px solid rgba(218,171,45,0.2); border-radius: 8px; font-size: 0.9rem;">
        <p><strong>Name:</strong> @authService.CurrentUser.UserName</p>
        <p><strong>Email:</strong> @authService.CurrentUser.Email</p>
        <p><strong>Role:</strong> @authService.CurrentUser.Role</p>
    </div>
}
else
{
    <p style="color: #A57A03;">Loading user...</p>
}

<h3>Add user</h3>

<EditForm Model="@user" OnValidSubmit="HandleSubmit" FormName="AddUserForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label for="UserNameInput">UserName</label>
    <InputText id="UserNameInput" @bind-Value="user.UserName" ></InputText>

    <label for="Email">Email</label>
    <InputText id="Email" @bind-Value="user.Email"></InputText>

    <label for="Password">Password</label>
    <InputText id="Password" type="password" @bind-Value="user.PasswordHashed"></InputText>

    <label for="Role">Role</label>
    <InputSelect id="Role" @bind-Value="user.Role">
        @foreach (var role in Enum.GetValues<Role>())
        {
            <option value="@role">@role</option>
        }
    </InputSelect>

    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

<h3>Delete user</h3>

<select @bind="DeleteOption" class="form-floating">
    <option value="">Select...</option>
    <option value="Id">Id</option>
    <option value="name">Name</option>
</select>

@if (DeleteOption != "")
{
    @switch (DeleteOption)
    {
        case "Id":
            <InputNumber @bind-Value="delId" />
            break;

        case "name":
            <InputText @bind-Value="delData" />
            break;

        default:
            break;
    }

    if (DeleteOption == "Id" && delId > 0 || DeleteOption == "name" && delData != "")
    {
        <button @onclick="HandleDelete">Delete user</button>
    }
}
<h3>Update</h3>

<span>Choose id of the user u wanna change</span>
<InputNumber @bind-Value="idToChange" placeHolder="enter id"/>

@if (idToChange != null)
{
    <select @bind="updateOption" class="form-floating">
        <option value="email">email</option>
        <option value="name">user name</option>
    </select>
}

@switch(updateOption)
{
    case "email": 
   <InputText @bind-Value="updateValue" />
        break;

        case "name":
        <InputText  @bind-Value="updateValue" />
        break;

        default:
        break;

}

@if(updateValue != "")
{
    <button @onclick="HandleUpdate">update user</button>
}


<span style="color:@messageColor">@message</span>

@code {
    User user = new User();
    List<User>? allUsers = null;

    string updateOption = "";
    int? idToChange = null;
    string updateValue ="" ;

    string DeleteOption = "";
    string delData = "";
    int delId;
    bool beenClicked = false;
    string message = "";
    string messageColor = "";

    string? currentuser = "";

    List<Property> properties;

    protected override void OnInitialized()
    {
        properties = propertyService.GetAllProperties().ToList();
    }

    public void Logout() {
        authService.LogOut();
        navmag.NavigateTo("/Signin");

    }

    public void HandleUpdate()
    {
        if(idToChange != null){
            if (updateOption == "name" )
                UserService.UpdateUserName(idToChange.Value, updateValue);
            if (updateOption == "email")
                UserService.UpdateUserEmail(idToChange.Value, updateValue);
        }
    }

    public void HandleSubmit(EditContext editContext)
    {

        var NewUser = (User)editContext.Model;
        UserService.AddUser(NewUser);
        user = new User();
    }

    public void HandleDelete()
    {
        try
        {
            switch (DeleteOption)
            {
                case "Id":
                    UserService.DeleteUserById(delId);
                    break;

                case "name":
                    UserService.DeleteUserByName(delData);
                    break;
            }
            message = "User deleted successfully!";
            messageColor = "green";
        }
        catch
        {
            message = "Problem deleting user.";
            messageColor = "red";
        }
    }

    public void GetAllUsers()
    {
        allUsers = UserService.GetAllUsers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await authService.LoadAsync();  
            StateHasChanged();
        }
    }
}
