@page "/"
@page "/{Fillter?}"
@using RealEstateProj.Data
@using RealEstateProj.Data.Interfaces
@inject IPropertyService propertyService

<div class="cards-grid">
    @foreach (var property in properties)
    {
        <ProperyCard PropertyId="@property.Id"
            Title="@property.Title"
            City="@property.City"
            Address="@property.Address"
            Price="@property.Price"
            Rooms="@property.Rooms"
            Size="@property.Size"
            Status="@property.Status"
            Description="@property.Description"
            Images="@property.Images" />
    }
</div>


@code {
    List<Property> properties = new();
    [Parameter] public string? Fillter { get; set; }

    async Task FillterPropertyAsync()
    {
        properties = Fillter switch
        {
            "Rent" => propertyService.GetAllForRent(),
            "Sale" => propertyService.GetAllForSale(),
            _ => await propertyService.GetAllPropertiesAsync()
        };
    }

    protected override void OnParametersSet()
    {
       FillterPropertyAsync();
    }

    protected override async Task OnInitializedAsync()
    {
          properties =  await propertyService.GetAllPropertiesAsync();
    }

}

