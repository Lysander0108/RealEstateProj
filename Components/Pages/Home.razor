@page "/"
@page "/{Fillter?}"
@using RealEstateProj.Data
@using RealEstateProj.Data.Interfaces
@inject IPropertyService propertyService

<div class="cards-grid">
    @foreach (var property in properties)
    {
        <ProperyCard PropertyId="@property.Id"
            Title="@property.Title"
            City="@property.City"
            Address="@property.Address"
            Price="@property.Price"
            Rooms="@property.Rooms"
            Size="@property.Size"
            Status="@property.Status"
            Description="@property.Description"
            Images="@property.Images" />
    }
</div>

@code {
    List<Property> properties = new();
    [Parameter] public string? Fillter { get; set; }

    void FillterProperty()
    {
        switch (Fillter)
        {
            case "Rent":
                properties = propertyService.GetAllForRent();
                break;
            case "Sale":
                properties = propertyService.GetAllForSale();
                break;
            default:
                properties = propertyService.GetAllProperties().ToList();
                break;
        }
    }

    protected override void OnParametersSet()
    {
        FillterProperty();
    }

    protected override void OnInitialized()
    {
        properties = propertyService.GetAllProperties().ToList();
     }
}

