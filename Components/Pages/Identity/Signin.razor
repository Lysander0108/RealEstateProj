@page "/signin"
@using RealEstateProj.Data
@using RealEstateProj.Data.Interfaces
@using RealEstateProj.Components.Pages.Identity

@inject IUserService UserService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Sign In</PageTitle>

<div class="login-page">
    <div class="login-card">
        <h2 class="login-title">Sign In</h2>

        <div class="login-form">
            <div class="input-group">
                <input type="email" @bind="email" placeholder="Email" />
                <i class="fa fa-envelope"></i>
            </div>
            <div class="input-group">
                <input type="password" @bind="password" placeholder="Password" />
                <i class="fa fa-lock"></i>
            </div>

            <button class="login-btn" @onclick="HandleSignIn">Sign In</button>
        </div>

        @if (message != "")
        {
            <div class="login-message error">@message</div>
        }

        <div class="login-footer">
            <span>Don't have an account?</span>
            <button class="switch-btn" @onclick='() => Navigation.NavigateTo("/login")'>Register</button>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string message = "";

    private void HandleSignIn()
    {
        message = "";

       
        var user = UserService.GetUserByEmail(email);

        if (user == null || !UserService.VerifyPassword(user, password))
        {
            message = "Invalid email or password.";
            return;
        }

        AuthService.Sighin(user);
        Navigation.NavigateTo("/");
    }
}
