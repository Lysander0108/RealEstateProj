@inject NavigationManager navigationManager

@if (isOpen)
{
    <div class="sidebar-overlay" @onclick="ToggleSideBar"></div>
}

<div class="SideBar @(isOpen ? "open" : "close")">
    
    <div class="SideBar-options">
        <button @onclick='() => NavigateAndClose("/")'>Home</button>
        <button @onclick='() => NavigateAndClose("/")'>ForRent</button>
        <button @onclick='() => NavigateAndClose("/")'>LforSale</button>
        <button @onclick='() => NavigateAndClose("/")'>Contact</button>
    </div>
</div>

@code {
    [Parameter] public bool isOpen { get; set; }
    [Parameter] public EventCallback ToggleSideBar { get; set; }

    async Task NavigateAndClose(string url)
    {
        await ToggleSideBar.InvokeAsync();
        navigationManager.NavigateTo(url);
    }
}
