@inject NavigationManager navigationManager

<div class="SideBar @(isOpen ? "open" : "close")">
    <button class="close-X" @onclick="ToggleSideBar">X</button>
    <div class="SideBar-options">
        <button @onclick='() => NavigateAndClose("/")'>Home</button>
        <button @onclick='() => NavigateAndClose("/AllProperties")'>All properties</button>
        <button @onclick='() => NavigateAndClose("/LikedProperties")'>Liked properties</button>
        <button @onclick='() => NavigateAndClose("/about")'>About us</button>
    </div>
</div>

@code {
    [Parameter] public bool isOpen { get; set; }
    [Parameter] public EventCallback ToggleSideBar { get; set; }

    async Task NavigateAndClose(string url)
    {
        await ToggleSideBar.InvokeAsync(); // Close sidebar first
        navigationManager.NavigateTo(url);
    }
}
