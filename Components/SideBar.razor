@using RealEstateProj.Identity
@inject NavigationManager navigationManager
@inject AuthService auth

@if (isOpen)
{
    <div class="sidebar-overlay" @onclick="ToggleSideBar"></div>
}

<div class="SideBar @(isOpen ? "open" : "close")">
    
    <div class="SideBar-options">
        <button @onclick='() => NavigateAndClose("/")'>All properties</button>
        <button @onclick='() => NavigateAndClose("/Rent")'>For Rent</button>
        <button @onclick='() => NavigateAndClose("/Sale")'>For Sale</button>
        @if (auth.IsLogged())
        {
            <button @onclick="LogOut" >Log out</button>            

        }
        else
        {
            <button @onclick=' () => NavigateAndClose("/login")'>Login</button>
        }

        @if(auth.IsAgent())
        {
            <button @onclick='() => NavigateAndClose("/AdminPage")'>Admin</button>
        }

    </div>
</div>

@code {
    [Parameter] public bool isOpen { get; set; }
    [Parameter] public EventCallback ToggleSideBar { get; set; }



    public async Task LogOut()
    {
        await auth.LogOut();
        await NavigateAndClose("/sighin");
    }



   
    async Task NavigateAndClose(string url)
    {
        await ToggleSideBar.InvokeAsync();
        navigationManager.NavigateTo(url);
    }
}
