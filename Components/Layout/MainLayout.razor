@inherits LayoutComponentBase
 @using RealEstateProj.Components.Pages.Identity
 @inject AuthService authservice
 @inject NavigationManager navigationManager

<SideBar isOpen="@toggleSideBar" ToggleSideBar="@ToggleSideBar" />




<div class="top-row">
    <div class="left-section">
        <i class="fa-solid fa-bars" style="width: 30px; cursor: pointer;" @onclick="ToggleSideBar"></i>
        <nav>
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="/test">Test</a>
            <a class="fa-brands fa-github text-dark"
               href="https://github.com/Lysander0108/RealEstateProj" style="30px" target="_blank" rel="noopener noreferrer"></a>
        </nav>
    </div>
 
    <div class="right-section">
        <div class="top-rowText phoneNumber">
            055-555-5555
        </div>
        <div class="top-rowText-logo">
            LOGO
        </div>
    </div>
</div>

<div class="main-content">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    bool toggleSideBar;
    void ToggleSideBar() => toggleSideBar = !toggleSideBar;

    string uri = "";

    protected override void OnInitialized()
    {
        var uri = navigationManager.Uri.ToLower();

        if (uri.Contains("/signin") || uri.Contains("/login"))
            return;

        if (!authservice.IsLogged())
            navigationManager.NavigateTo("/signin");
    }
}