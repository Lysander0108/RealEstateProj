@inherits LayoutComponentBase
@using RealEstateProj.Identity
@inject AuthService authservice
@inject NavigationManager navigationManager

<SideBar isOpen="@toggleSideBar" ToggleSideBar="@ToggleSideBar" />


<div class="top-row">
    <div class="left-section">
        <i class="fa-solid fa-bars" style="width: 30px; cursor: pointer;" @onclick="ToggleSideBar"></i>

        <nav>
            <a class="nav-link" href="/">All Properties</a>
            <a class="nav-link" href="/Rent">For rent</a>
            <a class="nav-link" href="/Sale">For Sale</a>
            <a class="fa-brands fa-github text-dark"
               href="https://github.com/Lysander0108" style="30px" target="_blank" rel="noopener noreferrer"></a>
        </nav>
    </div>

    <div class="right-section">
        <div class="top-rowText-logo">
            055-555-5555
        </div>
        <div class="top-rowText-logo">
            A.R. Real Estate
        </div>
    </div>
</div>

<div class="main-content">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>



@code {
    bool toggleSideBar;
    void ToggleSideBar() => toggleSideBar = !toggleSideBar;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await authservice.LoadAsync();  

            var uri = navigationManager.Uri.ToLower();
            if (!authservice.IsLogged() && !uri.Contains("/register") && !uri.Contains("/login"))
            {
                navigationManager.NavigateTo("/login");
            }

            StateHasChanged();
        }
    }
}